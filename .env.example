# Copy this to .env and fill in real values for local dev.
# For a hosted deploy (Render/Railway/Fly.io), set these as environment
# variables in the platform's dashboard instead of committing a .env file.

# Required
OPENAI_API_KEY=
GROQ_API_KEY=
TAVILY_API_KEY=

# Optional — enables Langfuse tracing if both keys are set, otherwise tracing
# is skipped. Get these from a free project at https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Optional — defaults to https://cloud.langfuse.com. Use https://us.cloud.langfuse.com
# or your own self-hosted URL if applicable.
LANGFUSE_BASE_URL=

# Optional — which provider to use for the LLM (see config.yml). Defaults to openai.
LLM_PROVIDER=openai

# Optional — comma-separated origins allowed to call the API cross-origin.
# Defaults to localhost. Set this to your deployed URL once you have one,
# e.g. https://your-app.onrender.com
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
